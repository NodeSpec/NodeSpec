# NodeSpec self-host deployment configuration (SHIP-1(e)).
# Copy to deploy/selfhost/selfhost.env (gitignored) and edit. bootstrap.sh
# composes supabase/functions/.env and the frontend build args from this file.

# ── Required ────────────────────────────────────────────────────────────────

# THE deployment-mode flag (config, never a fork). Leave as-is.
NODESPEC_DEPLOYMENT=self-hosted

# Envelope key for stored customer secrets (AI keys, git tokens).
# Any long random string (e.g. `openssl rand -base64 32`).
# SET ONCE, BACK IT UP, NEVER CHANGE IT — changing it orphans stored secrets.
ENCRYPTION_SECRET=

# The signed license token issued by NodeSpec with your contract (nslic1.…).
# Missing/expired runs at community tier with a logged reason — never fatal.
NODESPEC_LICENSE=

# Where users reach the app (scheme + host + port, no trailing slash).
PUBLIC_APP_URL=http://localhost

# ── Frontend build inputs (single-origin mode: one port for everything) ─────

# The app's nginx PROXIES the Supabase surface (auth/rest/realtime/storage/
# functions) to Kong internally, so the API URL is the SAME origin as the app
# — no port suffix, and firewall-wise only FRONTEND_PORT is ever exposed
# (54321 stays closed to the outside; the MCP endpoint rides this origin).
# Set to the address THE USER'S BROWSER reaches, never 127.0.0.1 on a VM.
VITE_SUPABASE_URL=http://127.0.0.1
# Printed by `supabase start` (anon / publishable key). bootstrap.sh fills
# this in automatically if left empty.
VITE_SUPABASE_ANON_KEY=
VITE_MCP_PUBLIC_URL=http://127.0.0.1/functions/v1/mcp-server

# LOCAL TRUST MODE for the MCP connection. When 'true' AND this deployment
# has exactly one account, an MCP client connecting from this machine skips
# the browser sign-in — the authorize step approves itself for that account.
# The lane stands down on its own the moment a second account signs up or the
# account enrolls two-factor, and the authorization code is only ever
# delivered to a loopback address on the connecting machine. SET THIS TO
# false BEFORE exposing the deployment beyond your own machine.
MCP_LOCAL_TRUST=true

# The one externally exposed port (80 = survives port-filtering networks;
# enterprise proxies and later TLS want it anyway).
FRONTEND_PORT=80
# Cloudflare Turnstile. The test key passes every check — fine inside a
# firewall; swap for a real site key if the app is internet-facing.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Edition. Empty/absent = OSS community edition (plain sign-in landing, no
# marketing pages, no templates gallery). Enterprise bundles are delivered
# with this pre-set to 'enterprise' (keeps the templates gallery). Never set
# 'hosted' on a self-host deployment.
VITE_NODESPEC_EDITION=

# ── Optional ────────────────────────────────────────────────────────────────

# Platform-style AI features (users can also bring their own keys in-app).
# OPENAI_API_KEY=

# Dev-time license verification key override. Customer bundles have the key
# STAMPED into the functions at build time — leave this unset.
# NODESPEC_LICENSE_PUBLIC_KEY=

# Exists-check only: billing code paths require the variable to be present;
# Stripe is never called on a self-hosted deployment. Leave the dummy.
STRIPE_SECRET_KEY=sk_test_dummy_never_called_selfhost
