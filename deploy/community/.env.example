# NodeSpec Community Edition — compose configuration.
# Copy to .env (same directory) and edit. One value is REQUIRED:
# ENCRYPTION_SECRET. Everything else works out of the box for a LOCAL,
# single-machine install.
#
# EXPOSING BEYOND YOUR MACHINE? The JWT trio and passwords below are the
# public Supabase demo values — fine on localhost, an open door on a
# network. Regenerate ALL of them first (see the README's "Going beyond
# localhost" section) and set MCP_LOCAL_TRUST=false.

# ── Required ─────────────────────────────────────────────────────────────

# Envelope key for credentials you store in the app (git tokens, AI keys).
# Any long random string, e.g. `openssl rand -base64 32`.
# SET ONCE AND BACK IT UP — changing it makes stored credentials unreadable.
ENCRYPTION_SECRET=

# ── Where users reach the app ────────────────────────────────────────────

# The one exposed port, and the public origin built from it.
FRONTEND_PORT=80
SITE_URL=http://localhost

# ── Platform secrets (demo defaults: LOCALHOST ONLY) ─────────────────────

POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

# ── NodeSpec behavior ────────────────────────────────────────────────────

# Single-user local trust for the MCP connection: an AI client on this
# machine connects without the browser sign-in while exactly one account
# exists and it has no 2FA. SET false BEFORE exposing beyond your machine.
MCP_LOCAL_TRUST=true

# Cloudflare Turnstile. The test key passes every check — fine locally and
# offline; swap for a real site key if the app is internet-facing.
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Edition. Empty = OSS community edition. Never set 'hosted' here.
VITE_NODESPEC_EDITION=

# Signed license token (enterprise deployments only; empty runs community).
NODESPEC_LICENSE=
