# SB-4 · live bench harness config. Copy to scripts/bench/.env.bench (gitignored).
#
# The two Supabase keys are printed by `npx supabase status`. EITHER key format
# works — the slots map by privilege level, not by name:
#   newer CLI (~2.45+):  Publishable key (sb_publishable_…) → SUPABASE_ANON_KEY
#                        Secret key      (sb_secret_…)      → SUPABASE_SERVICE_ROLE_KEY
#   older CLI:           anon key / service_role key (legacy JWTs; also via
#                        `npx supabase status -o env` on many versions)
# The S3 access/secret keys in the status output are storage-only — never used here.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# A classic or fine-grained token with repo contents+PR read/write on the
# sandbox repo below. The harness FORCE-RESETS this repo before every scenario —
# use a dedicated throwaway repo, never a real one.
GITHUB_TOKEN=
BENCH_REPO=your-github-user/nodespec-bench-sandbox

# The SB-3 seeded staging identity (defaults match supabase/seed.sql — only
# override if you changed the seed).
#BENCH_USER=bench@nodespec.local
#BENCH_PASS=benchpass123
#MCP_API_KEY=ns_live_staging_bench_00000000000000000000000000000000

# Set to 1 ONLY to allow a non-local SUPABASE_URL (Guardrail 9: never production).
#ALLOW_NONLOCAL=0
