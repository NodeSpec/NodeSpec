# Staging bench env for locally-served edge functions (task SB-3).
# Copy to supabase/functions/.env (that file is gitignored), then restart the
# stack (`supabase stop && supabase start`).
#
# STRIPE_SECRET_KEY only needs to EXIST for the bench: create-free-customer
# checks the variable before its existing-customer early-exit, and the seeded
# bench user always takes that early-exit — Stripe is never actually called.
STRIPE_SECRET_KEY=sk_test_dummy_never_called_on_bench

# P0-1 (crypto envelope v2): dedicated secret for encrypting stored customer secrets
# (AI keys + git tokens). Any long random string works on the bench. Without it, new
# writes degrade to the legacy v1 format with a console warning.
ENCRYPTION_SECRET=staging-bench-encryption-secret-not-for-production

# V3 I: the address the MCP server advertises in its OAuth metadata and 401
# pointer. Unset, the CLI stack advertises the edge runtime's internal URL and
# a client's OAuth sign-in cannot come back; set it to the gateway address so
# the consent lane works locally (the app's VITE_MCP_PUBLIC_URL is the same URL).
MCP_PUBLIC_URL=http://127.0.0.1:54321/functions/v1/mcp-server
